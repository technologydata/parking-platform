# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by Git. NEVER put real values in this example file.

# Login for the local Postgres container (both the "parking" and "n8n" databases use it).
# Use letters and numbers only, because special characters break the connection URL.
POSTGRES_USER=parking_admin
POSTGRES_PASSWORD=change-me

# Key n8n uses to encrypt saved credentials.
# Generate it with PowerShell: [guid]::NewGuid().ToString("N")
# Set it BEFORE the first start and never change it afterwards.
N8N_ENCRYPTION_KEY=generate-a-random-value

# Secret that n8n sends in the X-API-Key header to call /internal endpoints.
# Generate it the same way. It must match the value saved in the n8n credential.
INTERNAL_API_KEY=generate-a-random-value